# Plantilla de variables de entorno del backend de ULima++.
#
# Copia este archivo a .env, que git ignora, y cambia los valores. Las variables salen de
# src/config/env.ts, que es la fuente de verdad, y siguen su mismo orden. Para arrancar en local
# solo DATABASE_URL tiene que ser auténtica. JWT_SECRET admite cualquier cadena de 8 o más
# caracteres, y COHERE_API_KEY cualquier texto no vacío mientras no pruebes el chatbot.
#
# No uses "vercel env pull" para obtener el .env. Ese comando escribe el texto [SENSITIVE] como
# valor de casi todas las variables, porque Vercel no descifra las marcadas como sensibles, y con
# ese archivo el backend no arranca. Parte de esta plantilla y completa los valores a mano.
#
# El repositorio es público. Este archivo no lleva ningún valor real, y una copia con valores
# reales nunca se sube a git.

# Obligatoria. URL de conexión a PostgreSQL. En local conviene una base propia o la rama develop
# de Neon, no la de producción.
DATABASE_URL=postgres://usuario:clave@localhost:5432/ulima

# Obligatoria. Secreto con el que se firman y verifican los JWT de sesión. Mínimo 8 caracteres.
JWT_SECRET=cambia-esto-por-8-o-mas-caracteres

# Opcional. Vigencia del JWT en segundos. Por defecto 86400, que son 24 horas.
JWT_EXPIRES_IN=86400

# Opcional. Puerto del servidor local. Por defecto 3000. Vercel lo ignora.
PORT=3000

# Opcional. development, production o test. Por defecto development. En Vercel va production.
NODE_ENV=development

# Opcional. Orígenes permitidos para CORS, separados por comas. Vacío deja CORS abierto (*), algo
# que conviene restringir en producción.
CORS_ORIGINS=

# Opcional. Clave de Resend para enviar el correo de restablecimiento de contraseña. Vacía y con
# NODE_ENV distinto de production, el código OTP se imprime en la consola con el prefijo [DEV ONLY].
RESEND_API_KEY=

# Opcional. Nombre de la cuenta de Cloudinary, que es el texto después de la @ en CLOUDINARY_URL y
# no el nombre de una API key. Las tres variables de Cloudinary (fotos de perfil) van juntas. Con
# las tres vacías la función queda apagada y todos se ven con iniciales.
CLOUDINARY_CLOUD_NAME=

# Opcional. Clave pública de la cuenta de Cloudinary. Va junto con las otras dos del grupo.
CLOUDINARY_API_KEY=

# Opcional. Secreto de firma de Cloudinary. Nunca sale del backend. Va junto con las otras dos.
CLOUDINARY_API_SECRET=

# Opcional. Remitente de los correos de Resend, con el formato Nombre <correo@dominio>. No uses un
# buzón no-reply, porque Gmail lo trata como señal de spam. El valor de ejemplo es el de fábrica.
RESEND_FROM=ULima+ <notificaciones@mail.grupo5app.lat>

# Opcional. Dirección de respuesta (Reply-To) de esos correos. Vacía, no se agrega la cabecera.
RESEND_REPLY_TO=

# Opcional. Máximo de códigos de restablecimiento por usuario y por hora. Por defecto 3. Súbelo
# solo de forma temporal en períodos de prueba.
PASSWORD_RESET_MAX_PER_HOUR=3

# Opcional. Identificador del proyecto de Firebase que usa el chat. Con las cuatro variables de
# Firebase vacías el chat queda inerte y el resto de la API funciona.
FIREBASE_PROJECT_ID=

# Opcional. Correo de la cuenta de servicio de Firebase Admin. Si se define, tiene que ser un
# correo válido.
FIREBASE_CLIENT_EMAIL=

# Opcional. Clave privada de esa cuenta de servicio, escrita en una sola línea y con los saltos de
# línea como \n literales.
FIREBASE_PRIVATE_KEY=

# Opcional. URL de la Realtime Database de Firebase donde se escriben los mensajes del chat. Si se
# define, tiene que ser una URL válida.
FIREBASE_DATABASE_URL=

# Obligatoria. Clave de API de Cohere, que solo usan el chatbot y el motivo del test de
# especialidad, aunque el arranque la exige siempre. En local sirve cualquier texto no vacío
# mientras no pruebes esas dos funciones.
COHERE_API_KEY=cambia-esto-por-tu-clave-de-cohere

# Opcional. Preguntas por alumno y por hora que admite el chatbot. Por defecto 20.
CHATBOT_RATE_LIMIT=20

# Opcional. Base de miUlima. El host está fijo en webaloe.ulima.edu.pe como defensa contra SSRF, y
# cualquier otro impide el arranque.
PORTAL_BASE_URL=https://webaloe.ulima.edu.pe

# Opcional. Tiempo máximo de cada petición saliente al portal, en milisegundos. Por defecto 8000.
PORTAL_TIMEOUT_MS=8000

# Opcional. Presupuesto de tiempo de POST /portal-sync/refresh, en milisegundos. Un valor fuera de
# 20000 a 65000 detiene el arranque. Por defecto 60000.
PORTAL_REFRESH_BUDGET_MS=60000

# Opcional. Base de los sílabos. El host está fijo en cactus.ulima.edu.pe, igual que el del portal,
# y cualquier otro impide el arranque.
SYLLABUS_BASE_URL=https://cactus.ulima.edu.pe

# Opcional. true o false, por defecto false. Desde la 2.1.0 es solo el respaldo del interruptor
# remoto. El modo lo decide la fila de la tabla app_setting (columna static_mode), que se edita en
# la consola de Neon y rige en unos 10 s. El backend usa esta variable solo cuando no puede leer
# esa fila y no leyó ninguna antes. Con true, POST /auth/register responde 503
# REGISTRATION_UNAVAILABLE y toda ruta bajo /portal-sync responde 503 PORTAL_DESACTIVADO.
# Cualquier otro valor impide el arranque.
MODO_ESTATICO=false
